FROM diffdrivebot:harmonic

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        xvfb x11vnc novnc websockify fluxbox mesa-utils && \
    apt-get clean

RUN printf '%s\n' \
    '#!/bin/bash' \
    'export DISPLAY=:1' \
    'LOG=/tmp/desktop-logs' \
    'mkdir -p "$LOG"' \
    '' \
    '# On a container restart the X lock/socket can survive while the server does not.' \
    'if ! pgrep -f "Xvfb :1 " >/dev/null 2>&1; then' \
    '    rm -f /tmp/.X1-lock /tmp/.X11-unix/X1' \
    '    setsid Xvfb :1 -screen 0 1280x800x24 >"$LOG/xvfb.log" 2>&1 </dev/null &' \
    '    for _ in $(seq 1 50); do' \
    '        [ -S /tmp/.X11-unix/X1 ] && break' \
    '        sleep 0.1' \
    '    done' \
    'fi' \
    '' \
    'if ! pgrep -x Xvfb >/dev/null 2>&1; then' \
    '    echo "ERROR: Xvfb failed to start; see $LOG/xvfb.log" >&2' \
    '    exit 1' \
    'fi' \
    '' \
    'pgrep -x fluxbox >/dev/null 2>&1 || setsid fluxbox >"$LOG/fluxbox.log" 2>&1 </dev/null &' \
    'pgrep -x x11vnc >/dev/null 2>&1 || setsid x11vnc -display :1 -nopw -forever -shared -rfbport 5900 >"$LOG/x11vnc.log" 2>&1 </dev/null &' \
    'pgrep -f "websockify.*6080" >/dev/null 2>&1 || setsid websockify --web /usr/share/novnc 6080 localhost:5900 >"$LOG/websockify.log" 2>&1 </dev/null &' \
    '' \
    'sleep 1' \
    'if ! pgrep -x x11vnc >/dev/null 2>&1; then' \
    '    echo "ERROR: x11vnc failed to start; see $LOG/x11vnc.log" >&2' \
    '    exit 1' \
    'fi' \
    'if ! pgrep -f "websockify.*6080" >/dev/null 2>&1; then' \
    '    echo "ERROR: websockify failed to start; see $LOG/websockify.log" >&2' \
    '    exit 1' \
    'fi' \
    '' \
    'echo "Desktop ready: http://localhost:6767/vnc.html  (logs: $LOG)"' \
    > /usr/local/bin/start_desktop.sh && \
    chmod +x /usr/local/bin/start_desktop.sh

USER docker
RUN echo 'export GZ_SIM_SYSTEM_PLUGIN_PATH=/opt/ros/jazzy/lib/:/usr/lib:/usr/lib/aarch64-linux-gnu' >> ~/.bashrc
RUN echo 'export LIBGL_ALWAYS_SOFTWARE=1' >> ~/.bashrc

# Repository/workspace paths and the Gazebo resource path (meshes live in the repo)
RUN echo 'export REPO=/tmp/diffdrivebot' >> ~/.bashrc && \
    echo 'export PKG=~/workspace/src/diffdrivebot' >> ~/.bashrc && \
    echo 'export D=$PKG/worlds' >> ~/.bashrc && \
    echo 'export DATA=/home/docker/datasets' >> ~/.bashrc && \
    echo 'export GZ_SIM_RESOURCE_PATH=$PKG:${GZ_SIM_RESOURCE_PATH}' >> ~/.bashrc